[% INCLUDE 'doc-head-open.inc' %]
<title>Media Asset Management (MAM) &ndash; Dashboard</title>
[% INCLUDE 'doc-head-close.inc' %]
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="sub-header">
    <nav id="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/mainpage.pl" title="Home"><span class="visually-hidden-focusable">Home</span></a>
            </li>
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/admin/admin-home.pl">Administration</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
            </li>

            <li class="breadcrumb-item active" aria-current="page">
                <a aria-disabled="true" tabindex="-1"><span>Media Asset Management (MAM) &ndash; Dashboard</span></a>
            </li>
        </ol>
    </nav>
</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">

            <h1><i class="fa fa-upload"></i> Media Asset Management (MAM) Dashboard</h1>

            <!-- ── Connection-Test Result ──────────────────────── -->
            [% IF test_performed %]
                [% IF test_success %]
                    <div class="alert alert-success">
                        <i class="fa fa-check-circle"></i>
                        <strong>Connection Test Passed:</strong>
                        [% test_message | html %]
                    </div>
                [% ELSE %]
                    <div class="alert alert-danger">
                        <i class="fa fa-times-circle"></i>
                        <strong>Connection Test Failed:</strong>
                        [% test_message | html %]
                    </div>
                [% END %]
            [% END %]

            <!-- ── Configuration Status ────────────────────────── -->
            <div class="panel panel-default">
                <div class="panel-heading" style="padding:8px 20px;">
                    <h3 class="panel-title">
                        Plugin Status -  
						[% IF is_configured %]
                            <small class="text-success">Configured</small>
                        [% ELSE %]
                            <small class="text-danger">Not Configured</small>
                        [% END %]
                    </h3>
                </div>
                <div class="panel-body" style="padding:10px 20px;">
                    <table class="table table-condensed">
                        <tbody>
                            <tr>
                                <th style="width:200px;">MAM URL</th>
                                <td>
                                    [% IF mam_url %]
                                        <code>[% mam_url | html %]</code>
                                    [% ELSE %]
                                        <span class="text-danger"><i class="fa fa-warning"></i> Not set</span>
                                    [% END %]
                                </td>
                            </tr>
                            <tr>
                                <th>Shared Secret</th>
                                <td>
                                    [% IF is_configured %]
                                        <span class="text-success"><i class="fa fa-lock"></i> Configured</span>
                                    [% ELSE %]
                                        <span class="text-danger"><i class="fa fa-warning"></i> Not set</span>
                                    [% END %]
                                </td>
                            </tr>
                            <tr>
                                <th>Token TTL</th>
                                <td>[% token_ttl | html %] seconds</td>
                            </tr>
                            <tr>
                                <th>Button Label</th>
                                <td>&ldquo;[% button_label | html %]&rdquo;</td>
                            </tr>
                            <tr>
                                <th>Allowed Permissions</th>
                                <td><code>[% allowed_perms | html %]</code></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mam-actions" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:16px 0;">
                        <a class="btn btn-default btn-sm"
                           href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=configure">
                            <i class="fa fa-cog"></i> Edit Configuration
                        </a>
                        [% IF is_configured %]
                            <a class="btn btn-info btn-sm"
                               href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool&amp;op=test_connection">
                                <i class="fa fa-plug"></i> Test Connection
                            </a>
                        [% END %]
                    </div>
                </div>
            </div>

            <!-- ── Activity Log ────────────────────────────────── -->
            <div class="panel panel-default mam-recent-activity" style="margin-top:20px; margin-bottom:20px;">
                <div class="panel-heading" style="padding:8px 20px;">
                    <h3 class="panel-title">
                        <i class="fa fa-list"></i> Recent Activity
                        <small class="text-muted">(last 50 events &middot; auto-purged after 90 days)</small>
                    </h3>
                </div>
                <div class="panel-body" style="padding:20px;">
                    [% IF logs.size %]
                        <div class="table-responsive">
                            <table class="table table-striped table-condensed table-hover" id="mm-activity-log">
                                <thead>
                                    <tr>
                                        <th>Date / Time</th>
                                        <th>User</th>
                                        <th>Biblio&nbsp;#</th>
                                        <th>Action</th>
                                        <th>Status</th>
                                        <th>IP Address</th>
                                        <th>Details</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [% FOREACH log IN logs %]
                                        <tr class="[% IF log.status == 'denied' %]warning[% ELSIF log.status == 'failed' %]danger[% END %]">
                                            <td style="white-space:nowrap;">[% log.created_at | html %]</td>
                                            <td>[% log.userid | html %]</td>
                                            <td>
                                                [% IF log.biblionumber %]
                                                    <a href="/cgi-bin/koha/catalogue/detail.pl?biblionumber=[% log.biblionumber | uri %]"
                                                       title="View bibliographic record">
                                                        [% log.biblionumber | html %]
                                                    </a>
                                                [% ELSE %]
                                                    &mdash;
                                                [% END %]
                                            </td>
                                            <td>[% log.action | html %]</td>
                                            <td>
                                                [% IF log.status == 'success' %]
                                                    <span class="label label-success">[% log.status | html %]</span>
                                                [% ELSIF log.status == 'denied' %]
                                                    <span class="label label-warning">[% log.status | html %]</span>
                                                [% ELSE %]
                                                    <span class="label label-danger">[% log.status | html %]</span>
                                                [% END %]
                                            </td>
                                            <td>[% log.ip_address | html %]</td>
                                            <td>[% log.details | html %]</td>
                                        </tr>
                                    [% END %]
                                </tbody>
                            </table>
                        </div>
                    [% ELSE %]
                        <p class="text-muted"><i class="fa fa-info-circle"></i> No activity recorded yet. Entries appear here when staff use the Media Asset Management (MAM) button.</p>
                    [% END %]
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Activate DataTables sorting/search if available -->
<script>
$(document).ready(function(){
    if($.fn.DataTable && document.getElementById('mm-activity-log')){
        $('#mm-activity-log').DataTable({
            'order':     [[0,'desc']],
            'pageLength': 25,
            'language':  { 'emptyTable': 'No activity recorded yet' }
        });
    }
});
</script>

[% INCLUDE 'intranet-bottom.inc' %]
