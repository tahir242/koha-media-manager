[% INCLUDE 'doc-head-open.inc' %]
<title>Media Asset Management (MAM) &ndash; [% error_title | html %]</title>
[% INCLUDE 'doc-head-close.inc' %]
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="sub-header">
    <nav id="breadcrumbs" aria-label="Breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/mainpage.pl" title="Home"><span class="visually-hidden-focusable">Home</span></a>
            </li>
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/admin/admin-home.pl">Administration</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool">Media Asset Management (MAM)</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <a aria-disabled="true" tabindex="-1"><span>[% error_title | html %]</span></a>
            </li>
        </ol>
    </nav>
</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">

            <div class="alert alert-danger" style="margin-top:20px;">
                <h3><i class="fa fa-exclamation-triangle"></i> [% error_title | html %]</h3>
                <p>[% error_message | html %]</p>

                [% IF required_permissions %]
                    <p style="margin-top:10px;">
                        Required permissions: <code>[% required_permissions | html %]</code>
                    </p>
                [% END %]
            </div>

            <div class="mam-actions" style="display:flex; flex-wrap:wrap; align-items:center; gap:10px; margin:16px 0;">
                <a class="btn btn-default"
                   href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=tool">
                    <i class="fa fa-arrow-left"></i> Back to Dashboard
                </a>
                [% IF show_configure_link %]
                    <a class="btn btn-primary"
                       href="/cgi-bin/koha/plugins/run.pl?class=[% CLASS | uri %]&amp;method=configure">
                        <i class="fa fa-cog"></i> Configure Plugin
                    </a>
                [% END %]
            </div>

        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
